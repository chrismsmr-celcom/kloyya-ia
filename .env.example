# --- App ---
ENV=development
API_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:5500
LOG_LEVEL=INFO

# --- Supabase ---
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# Utiliser le connection string "Transaction pooler" de Supabase (port 6543)
DATABASE_URL=postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres

# --- Composio ---
COMPOSIO_API_KEY=
COMPOSIO_REDIRECT_BASE_URL=http://localhost:8000/api/connections

# --- LLM providers (renseigner ceux que vous utilisez réellement) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

DEFAULT_PLANNER_MODEL=anthropic/claude-sonnet-4-6
DEFAULT_REASONING_MODEL=anthropic/claude-opus-4-1
DEFAULT_FAST_MODEL=openai/gpt-4o-mini
DEFAULT_RESEARCH_MODEL=perplexity/sonar-pro
DEFAULT_EMBEDDING_MODEL=openai/text-embedding-3-large

# --- RAG ---
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=8
RAG_MIN_SIMILARITY=0.72
DOCUMENT_STORAGE_BUCKET=workspace-documents

# --- Patchright ---
PATCHRIGHT_HEADLESS=true
PATCHRIGHT_TIMEOUT_MS=45000

# --- Run engine ---
REDIS_URL=redis://redis:6379/0
RUN_WALL_CLOCK_CAP_SECONDS=1200
RUN_TOKEN_BUDGET=400000
RUN_CONCURRENCY_PER_WORKSPACE=2

# --- Billing ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Transcription ---
TRANSCRIPTION_PROVIDER=openai